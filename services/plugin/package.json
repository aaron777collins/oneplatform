{
  "name": "@oneplatform/plugin-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "test:integration:level1": "vitest run --config vitest.integration.ts",
    "test:integration:level2": "vitest run --config vitest.integration-l2.ts",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oneplatform/core": "workspace:*",
    "ajv": "^6.15.0",
    "hono": "^4.0.0",
    "ioredis": "^5.0.0",
    "pg": "^8.0.0",
    "semver": "^7.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/pg": "*",
    "@types/semver": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
