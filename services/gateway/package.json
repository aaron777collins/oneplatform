{
  "name": "@oneplatform/gateway-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node -e \"const fs=require('fs');const s='src/db/migrations';const t='dist/db/migrations';if(fs.existsSync(s)){fs.mkdirSync(t,{recursive:true});for(const f of fs.readdirSync(s))if(f.endsWith('.sql'))fs.copyFileSync(s+'/'+f,t+'/'+f);}\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:integration:level1": "vitest run --config vitest.integration.ts",
    "test:integration:level2": "vitest run --config vitest.integration-l2.ts",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "docs:generate": "npx tsx ../../tools/openapi-gen/src/cli.ts --service gateway --meta src/openapi-meta.ts --out dist/openapi/gateway.json"
  },
  "dependencies": {
    "@oneplatform/core": "workspace:*",
    "@oneplatform/openapi-gen": "workspace:*",
    "@oneplatform/sdk": "workspace:*",
    "bullmq": "^5.0.0",
    "hono": "^4.0.0",
    "ioredis": "^5.0.0",
    "jose": "^6.0.0",
    "lru-cache": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/pg": "*",
    "tsx": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
