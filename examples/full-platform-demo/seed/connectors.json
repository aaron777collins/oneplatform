[
  {
    "tenantId": "tenant_acme_001",
    "id": "connector_salesforce_acme",
    "name": "Salesforce CRM",
    "type": "rest-api",
    "description": "Syncs customer, opportunity, and contact data from Salesforce CRM via the Bulk API 2.0.",
    "config": {
      "baseUrl": "https://acme-corp.my.salesforce.com",
      "authType": "oauth2",
      "tokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "apiVersion": "v59.0",
      "objects": ["Account", "Contact", "Opportunity", "Lead"],
      "batchSize": 500,
      "useBulkApi": true,
      "rateLimitRequestsPerMinute": 100
    },
    "schedule": {
      "type": "interval",
      "intervalMinutes": 15,
      "enabled": true
    },
    "credentials": {
      "clientId": { "source": "env", "envVar": "SF_CLIENT_ID" },
      "clientSecret": { "source": "env", "envVar": "SF_CLIENT_SECRET" },
      "refreshToken": { "source": "env", "envVar": "SF_REFRESH_TOKEN" }
    }
  },
  {
    "tenantId": "tenant_acme_001",
    "id": "connector_postgres_warehouse",
    "name": "Data Warehouse (PostgreSQL)",
    "type": "database",
    "description": "Reads order history, product inventory, and financial data from the central PostgreSQL data warehouse.",
    "config": {
      "host": "warehouse.internal.acmecorp.example.com",
      "port": 5432,
      "database": "acme_warehouse",
      "schema": "public",
      "tables": ["orders", "order_items", "products", "inventory", "customers"],
      "useSsl": true,
      "sslMode": "verify-full",
      "connectionPoolSize": 5,
      "queryTimeoutSeconds": 120,
      "incrementalColumn": "updated_at",
      "primaryKeyColumn": "id"
    },
    "schedule": {
      "type": "cron",
      "cronExpression": "0 */6 * * *",
      "timezone": "America/New_York",
      "enabled": true
    },
    "credentials": {
      "username": { "source": "env", "envVar": "DW_USERNAME" },
      "password": { "source": "env", "envVar": "DW_PASSWORD" },
      "sslCertificate": { "source": "env", "envVar": "DW_SSL_CERT" }
    }
  },
  {
    "tenantId": "tenant_acme_001",
    "id": "connector_support_api",
    "name": "Support Ticket API",
    "type": "rest-api",
    "description": "Polls the internal support ticket system for new and updated tickets via REST API.",
    "config": {
      "baseUrl": "https://support.internal.acmecorp.example.com/api/v2",
      "authType": "api-key",
      "headerName": "X-API-Key",
      "endpoints": [
        {
          "path": "/tickets",
          "method": "GET",
          "params": { "status": "open,pending", "sort": "updated_at:desc" },
          "pagination": { "type": "cursor", "cursorParam": "after", "cursorPath": "meta.next_cursor" }
        }
      ],
      "rateLimitRequestsPerMinute": 60
    },
    "schedule": {
      "type": "interval",
      "intervalMinutes": 5,
      "enabled": true
    },
    "credentials": {
      "apiKey": { "source": "env", "envVar": "SUPPORT_API_KEY" }
    }
  },
  {
    "tenantId": "tenant_widget_002",
    "id": "connector_shopify_widget",
    "name": "Shopify Store",
    "type": "rest-api",
    "description": "Syncs product catalog, orders, and customer data from the Widget Co Shopify store via the Admin API.",
    "config": {
      "baseUrl": "https://widgetco.myshopify.com",
      "authType": "api-key",
      "headerName": "X-Shopify-Access-Token",
      "apiVersion": "2024-07",
      "resources": ["products", "orders", "customers", "inventory_levels"],
      "batchSize": 250,
      "rateLimitRequestsPerMinute": 40
    },
    "schedule": {
      "type": "interval",
      "intervalMinutes": 10,
      "enabled": true
    },
    "credentials": {
      "accessToken": { "source": "env", "envVar": "SHOPIFY_ACCESS_TOKEN" }
    }
  },
  {
    "tenantId": "tenant_widget_002",
    "id": "connector_ga4_widget",
    "name": "Google Analytics 4",
    "type": "rest-api",
    "description": "Imports web analytics data (sessions, page views, conversions) from Google Analytics 4 via the Data API.",
    "config": {
      "baseUrl": "https://analyticsdata.googleapis.com",
      "authType": "oauth2",
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "propertyId": "properties/123456789",
      "metrics": ["sessions", "totalUsers", "screenPageViews", "conversions", "averageSessionDuration"],
      "dimensions": ["date", "country", "deviceCategory", "sessionSource"],
      "dateRange": { "type": "relative", "days": 30 },
      "rateLimitRequestsPerMinute": 10
    },
    "schedule": {
      "type": "cron",
      "cronExpression": "0 4 * * *",
      "timezone": "Europe/London",
      "enabled": true
    },
    "credentials": {
      "clientId": { "source": "env", "envVar": "GA_CLIENT_ID" },
      "clientSecret": { "source": "env", "envVar": "GA_CLIENT_SECRET" },
      "refreshToken": { "source": "env", "envVar": "GA_REFRESH_TOKEN" }
    }
  }
]
