[
  {
    "tenantId": "tenant_acme_001",
    "id": "app_executive_dashboard",
    "name": "Executive Dashboard",
    "description": "Real-time executive dashboard showing key business metrics: revenue trends, customer growth, order volume, and support health. Built for the Acme Corp leadership team.",
    "type": "dashboard",
    "config": {
      "layout": "grid",
      "refreshIntervalSeconds": 60,
      "theme": "light",
      "widgets": [
        {
          "id": "widget_revenue_chart",
          "type": "line-chart",
          "title": "Monthly Revenue Trend",
          "position": { "x": 0, "y": 0, "width": 6, "height": 4 },
          "dataSource": {
            "entityType": "Order",
            "aggregation": "sum",
            "field": "totalAmount",
            "groupBy": "orderDate",
            "granularity": "month",
            "dateRange": { "type": "relative", "months": 12 }
          }
        },
        {
          "id": "widget_customer_count",
          "type": "metric-card",
          "title": "Total Customers",
          "position": { "x": 6, "y": 0, "width": 3, "height": 2 },
          "dataSource": {
            "entityType": "Customer",
            "aggregation": "count"
          }
        },
        {
          "id": "widget_order_volume",
          "type": "metric-card",
          "title": "Orders This Month",
          "position": { "x": 9, "y": 0, "width": 3, "height": 2 },
          "dataSource": {
            "entityType": "Order",
            "aggregation": "count",
            "dateRange": { "type": "relative", "months": 1 }
          }
        },
        {
          "id": "widget_ticket_status",
          "type": "donut-chart",
          "title": "Support Tickets by Priority",
          "position": { "x": 6, "y": 2, "width": 6, "height": 4 },
          "dataSource": {
            "entityType": "SupportTicket",
            "aggregation": "count",
            "groupBy": "priority",
            "filters": [{ "field": "status", "operator": "in", "value": ["open", "pending"] }]
          }
        },
        {
          "id": "widget_top_customers",
          "type": "table",
          "title": "Top 10 Customers by Revenue",
          "position": { "x": 0, "y": 4, "width": 6, "height": 4 },
          "dataSource": {
            "entityType": "Order",
            "aggregation": "sum",
            "field": "totalAmount",
            "groupBy": "customerId",
            "orderBy": "totalAmount:desc",
            "limit": 10
          }
        },
        {
          "id": "widget_product_inventory",
          "type": "bar-chart",
          "title": "Low Stock Products",
          "position": { "x": 6, "y": 6, "width": 6, "height": 4 },
          "dataSource": {
            "entityType": "Product",
            "fields": ["name", "quantityInStock", "reorderThreshold"],
            "filters": [{ "field": "quantityInStock", "operator": "lte", "value": 50 }],
            "orderBy": "quantityInStock:asc",
            "limit": 15
          }
        }
      ]
    },
    "access": {
      "roles": ["tenant-admin", "business-analyst", "viewer"],
      "isPublic": false
    },
    "enabled": true
  },
  {
    "tenantId": "tenant_acme_001",
    "id": "app_inventory_manager",
    "name": "Inventory Management",
    "description": "Operational tool for the warehouse team to monitor stock levels, manage reorder thresholds, and track product movements. Includes forms for updating inventory counts.",
    "type": "crud-app",
    "config": {
      "primaryEntity": "Product",
      "features": {
        "search": true,
        "filters": true,
        "export": true,
        "bulkEdit": true,
        "inlineEdit": true
      },
      "columns": [
        { "field": "sku", "label": "SKU", "sortable": true, "width": 120 },
        { "field": "name", "label": "Product Name", "sortable": true },
        { "field": "category", "label": "Category", "sortable": true, "filterable": true },
        { "field": "quantityInStock", "label": "In Stock", "sortable": true, "type": "number" },
        { "field": "reorderThreshold", "label": "Reorder At", "type": "number" },
        { "field": "unitPrice", "label": "Unit Price", "type": "currency", "currency": "USD" },
        { "field": "supplier", "label": "Supplier", "filterable": true },
        { "field": "isActive", "label": "Active", "type": "boolean" },
        { "field": "updatedAt", "label": "Last Updated", "type": "datetime", "sortable": true }
      ],
      "defaultSort": { "field": "quantityInStock", "direction": "asc" },
      "rowActions": ["edit", "view-history"],
      "conditionalFormatting": [
        {
          "field": "quantityInStock",
          "condition": "lessThan",
          "value": 10,
          "style": "danger"
        },
        {
          "field": "quantityInStock",
          "condition": "lessThan",
          "value": 50,
          "style": "warning"
        }
      ]
    },
    "access": {
      "roles": ["tenant-admin", "data-engineer"],
      "isPublic": false
    },
    "enabled": true
  },
  {
    "tenantId": "tenant_widget_002",
    "id": "app_sales_dashboard",
    "name": "Sales Dashboard",
    "description": "E-commerce sales dashboard for Widget Co showing order trends, product performance, and web analytics. Designed for the sales and marketing teams.",
    "type": "dashboard",
    "config": {
      "layout": "grid",
      "refreshIntervalSeconds": 120,
      "theme": "light",
      "widgets": [
        {
          "id": "widget_daily_orders",
          "type": "line-chart",
          "title": "Daily Orders (Last 30 Days)",
          "position": { "x": 0, "y": 0, "width": 8, "height": 4 },
          "dataSource": {
            "entityType": "Order",
            "aggregation": "count",
            "groupBy": "createdAt",
            "granularity": "day",
            "dateRange": { "type": "relative", "days": 30 }
          }
        },
        {
          "id": "widget_total_revenue",
          "type": "metric-card",
          "title": "Revenue (This Month)",
          "position": { "x": 8, "y": 0, "width": 4, "height": 2 },
          "dataSource": {
            "entityType": "Order",
            "aggregation": "sum",
            "field": "totalPrice",
            "dateRange": { "type": "relative", "months": 1 }
          }
        },
        {
          "id": "widget_avg_order_value",
          "type": "metric-card",
          "title": "Avg Order Value",
          "position": { "x": 8, "y": 2, "width": 4, "height": 2 },
          "dataSource": {
            "entityType": "Order",
            "aggregation": "avg",
            "field": "totalPrice",
            "dateRange": { "type": "relative", "months": 1 }
          }
        },
        {
          "id": "widget_top_products",
          "type": "table",
          "title": "Top Selling Products",
          "position": { "x": 0, "y": 4, "width": 6, "height": 4 },
          "dataSource": {
            "entityType": "Product",
            "fields": ["title", "price", "inventoryQuantity"],
            "orderBy": "inventoryQuantity:asc",
            "limit": 10
          }
        },
        {
          "id": "widget_traffic_sources",
          "type": "donut-chart",
          "title": "Traffic by Device",
          "position": { "x": 6, "y": 4, "width": 6, "height": 4 },
          "dataSource": {
            "entityType": "WebSession",
            "aggregation": "sum",
            "field": "sessions",
            "groupBy": "deviceCategory",
            "dateRange": { "type": "relative", "days": 30 }
          }
        }
      ]
    },
    "access": {
      "roles": ["tenant-admin", "business-analyst", "viewer"],
      "isPublic": false
    },
    "enabled": true
  }
]
