# =============================================================================
# OnePlatform Full Demo — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values below.
#
#   cp .env.example .env
#
# All values prefixed with OP_ are read by the platform services at startup.
# Values without that prefix are used only by the seed script and Docker
# Compose override in this directory.
# =============================================================================

# ---------------------------------------------------------------------------
# Platform URL — where the gateway service is reachable.
# In the default Docker Compose setup this is https://localhost (Caddy terminates
# TLS with a self-signed certificate). If you have configured a custom domain
# in docker-compose.yml, update this to match.
# ---------------------------------------------------------------------------
OP_BASE_URL=https://localhost

# ---------------------------------------------------------------------------
# Admin API key — used by the seed script to create tenants, users, and all
# demo resources. Generate one from the platform UI under Settings > API Keys,
# or use the bootstrap key printed by op-init on first start.
#
# The key must have these scopes:
#   admin, connectors:write, ontologies:write, pipelines:write, apps:write
# ---------------------------------------------------------------------------
OP_API_KEY=op_live_REPLACE_ME

# ---------------------------------------------------------------------------
# Postgres — only needed if you override the default Docker stack credentials.
# The seed script does not connect to Postgres directly; it uses the SDK.
# These are passed through to docker-compose.override.yml for the seed service.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=dev_postgres_superuser

# ---------------------------------------------------------------------------
# Redis — default password for the admin user.
# ---------------------------------------------------------------------------
# REDIS_PASSWORD=          # Managed by op-init; override only for custom setups

# ---------------------------------------------------------------------------
# MinIO — object storage credentials.
# ---------------------------------------------------------------------------
OP_MINIO_USER=minioadmin
OP_MINIO_PASSWORD=oneplatform_minio_dev_2024

# ---------------------------------------------------------------------------
# Grafana — dashboard UI credentials.
# The demo override exposes Grafana on http://localhost:3100.
# ---------------------------------------------------------------------------
OP_GRAFANA_PASSWORD=admin

# ---------------------------------------------------------------------------
# TLS — Caddy reverse proxy mode.
# "internal" generates a self-signed cert for localhost (good for demos).
# "acme" uses Let's Encrypt (requires a real domain and port 80/443 open).
# ---------------------------------------------------------------------------
OP_TLS_MODE=internal
OP_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Observability — OTLP endpoint for distributed tracing.
# Default points to the Jaeger instance in the Docker stack.
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---------------------------------------------------------------------------
# Demo-specific settings
# ---------------------------------------------------------------------------

# Number of sample entity records to generate per entity type during seeding.
DEMO_RECORDS_PER_ENTITY=50

# Set to "true" to skip connector creation (useful if external APIs are
# unreachable in your network).
DEMO_SKIP_CONNECTORS=false

# Set to "true" to trigger all pipelines immediately after seeding.
DEMO_TRIGGER_PIPELINES=true
