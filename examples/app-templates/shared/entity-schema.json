{
  "$schema": "https://oneplatform.dev/schemas/entity/v1.json",
  "name": "Customer",
  "slug": "customer",
  "description": "Represents a customer account with contact details, lifecycle status, and revenue metrics.",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "format": "uuid",
      "required": true,
      "primaryKey": true,
      "description": "Unique identifier generated by the platform."
    },
    {
      "name": "firstName",
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 100,
      "description": "Customer's first name."
    },
    {
      "name": "lastName",
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 100,
      "description": "Customer's last name."
    },
    {
      "name": "email",
      "type": "string",
      "format": "email",
      "required": true,
      "unique": true,
      "description": "Primary email address. Must be unique across the tenant."
    },
    {
      "name": "phone",
      "type": "string",
      "format": "phone",
      "required": false,
      "description": "Phone number in E.164 format (e.g. +14155551234)."
    },
    {
      "name": "company",
      "type": "string",
      "required": false,
      "maxLength": 200,
      "description": "Company or organization name."
    },
    {
      "name": "status",
      "type": "string",
      "required": true,
      "enum": ["active", "inactive", "lead", "churned"],
      "default": "lead",
      "description": "Current lifecycle status of the customer."
    },
    {
      "name": "tier",
      "type": "string",
      "required": true,
      "enum": ["free", "starter", "professional", "enterprise"],
      "default": "free",
      "description": "Subscription tier or plan level."
    },
    {
      "name": "totalRevenue",
      "type": "number",
      "format": "currency",
      "required": false,
      "default": 0,
      "minimum": 0,
      "description": "Lifetime revenue in USD cents."
    },
    {
      "name": "lastContactedAt",
      "type": "string",
      "format": "date-time",
      "required": false,
      "description": "ISO 8601 timestamp of the most recent interaction."
    },
    {
      "name": "tags",
      "type": "array",
      "items": { "type": "string" },
      "required": false,
      "default": [],
      "description": "Free-form labels for segmentation (e.g. 'vip', 'beta-tester')."
    },
    {
      "name": "address",
      "type": "object",
      "required": false,
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "postalCode": { "type": "string" },
        "country": { "type": "string", "format": "iso-3166-alpha-2" }
      },
      "description": "Mailing address."
    },
    {
      "name": "notes",
      "type": "string",
      "required": false,
      "maxLength": 5000,
      "description": "Internal notes about this customer."
    },
    {
      "name": "avatarUrl",
      "type": "string",
      "format": "uri",
      "required": false,
      "description": "URL to the customer's profile image."
    },
    {
      "name": "createdAt",
      "type": "string",
      "format": "date-time",
      "required": true,
      "readOnly": true,
      "description": "Timestamp when the record was created. Set automatically by the platform."
    },
    {
      "name": "updatedAt",
      "type": "string",
      "format": "date-time",
      "required": true,
      "readOnly": true,
      "description": "Timestamp of the most recent update. Set automatically by the platform."
    }
  ],
  "indexes": [
    { "fields": ["email"], "unique": true },
    { "fields": ["status"] },
    { "fields": ["tier"] },
    { "fields": ["createdAt"] },
    { "fields": ["lastName", "firstName"] }
  ],
  "permissions": {
    "read": ["viewer", "editor", "admin"],
    "create": ["editor", "admin"],
    "update": ["editor", "admin"],
    "delete": ["admin"]
  }
}
