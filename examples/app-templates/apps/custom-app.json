{
  "$schema": "https://oneplatform.dev/schemas/app-config/v1.json",
  "template": "custom-app",
  "appName": "Acme CRM",
  "slug": "acme-crm",
  "description": "A complete customer relationship management application combining the Dashboard, CRUD Admin, and Form Builder templates with shared navigation and branding.",
  "version": "1.0.0",

  "entity": {
    "$ref": "../shared/entity-schema.json",
    "slug": "customer"
  },

  "theme": {
    "$ref": "../shared/theme.json"
  },

  "permissions": {
    "required": ["entity:read"],
    "roles": {
      "viewer": ["entity:read"],
      "editor": ["entity:read", "entity:create", "entity:update"],
      "admin": ["entity:read", "entity:create", "entity:update", "entity:delete"]
    }
  },

  "shell": {
    "topBar": {
      "logo": {
        "src": "/assets/logo.svg",
        "alt": "Acme CRM",
        "href": "/"
      },
      "breadcrumbs": true,
      "actions": [
        {
          "type": "themeToggle",
          "label": "Toggle dark mode"
        },
        {
          "type": "userMenu",
          "items": [
            { "label": "Profile", "action": "navigate", "target": "/settings/profile" },
            { "label": "Settings", "action": "navigate", "target": "/settings" },
            { "label": "Sign Out", "action": "signOut", "variant": "danger" }
          ]
        }
      ]
    },
    "sidebar": {
      "width": 240,
      "collapsible": true,
      "defaultCollapsed": false,
      "sections": [
        {
          "title": "Main",
          "items": [
            {
              "label": "Dashboard",
              "icon": "bar-chart-2",
              "path": "/dashboard",
              "templateRef": "dashboard",
              "permission": "entity:read"
            },
            {
              "label": "Customers",
              "icon": "users",
              "path": "/customers",
              "templateRef": "crud-admin",
              "permission": "entity:read",
              "badge": {
                "type": "count",
                "query": {
                  "entityType": "customer",
                  "aggregate": "count",
                  "filter": { "status": "lead" }
                },
                "label": "new leads"
              },
              "children": [
                {
                  "label": "All Customers",
                  "path": "/customers",
                  "filter": {}
                },
                {
                  "label": "Active",
                  "path": "/customers?status=active",
                  "filter": { "status": "active" }
                },
                {
                  "label": "Leads",
                  "path": "/customers?status=lead",
                  "filter": { "status": "lead" }
                },
                {
                  "label": "Churned",
                  "path": "/customers?status=churned",
                  "filter": { "status": "churned" }
                }
              ]
            },
            {
              "label": "New Customer",
              "icon": "user-plus",
              "path": "/onboarding",
              "templateRef": "form-builder",
              "permission": "entity:create"
            }
          ]
        },
        {
          "title": "Reports",
          "items": [
            {
              "label": "Revenue",
              "icon": "dollar-sign",
              "path": "/reports/revenue",
              "permission": "entity:read"
            },
            {
              "label": "Growth",
              "icon": "trending-up",
              "path": "/reports/growth",
              "permission": "entity:read"
            }
          ]
        },
        {
          "title": "Administration",
          "permission": "entity:delete",
          "items": [
            {
              "label": "Settings",
              "icon": "settings",
              "path": "/settings"
            },
            {
              "label": "Team",
              "icon": "shield",
              "path": "/settings/team"
            },
            {
              "label": "Integrations",
              "icon": "plug",
              "path": "/settings/integrations"
            }
          ]
        }
      ]
    },
    "footer": {
      "text": "Acme CRM powered by OnePlatform",
      "links": [
        { "label": "Documentation", "href": "https://docs.oneplatform.dev" },
        { "label": "Support", "href": "mailto:support@acme-corp.example.com" }
      ]
    }
  },

  "routes": [
    {
      "path": "/dashboard",
      "template": "dashboard",
      "config": {
        "$ref": "./dashboard.json"
      }
    },
    {
      "path": "/customers",
      "template": "crud-admin",
      "config": {
        "$ref": "./crud-admin.json"
      }
    },
    {
      "path": "/customers/:id",
      "template": "crud-admin",
      "view": "detail",
      "config": {
        "$ref": "./crud-admin.json"
      }
    },
    {
      "path": "/onboarding",
      "template": "form-builder",
      "config": {
        "$ref": "./form-builder.json"
      }
    },
    {
      "path": "/onboarding/success",
      "template": "form-builder",
      "view": "success",
      "config": {
        "$ref": "./form-builder.json"
      }
    },
    {
      "path": "/reports/revenue",
      "template": "dashboard",
      "config": {
        "overrides": {
          "title": "Revenue Report",
          "focusMetric": "totalRevenue"
        }
      }
    },
    {
      "path": "/reports/growth",
      "template": "dashboard",
      "config": {
        "overrides": {
          "title": "Growth Report",
          "focusMetric": "customerCount"
        }
      }
    }
  ],

