--     PARTITION OF ingestion.raw_{{CONNECTOR_ID}}
--     FOR VALUES FROM ('2026-07-01') TO ('2026-08-01');
--
-- CREATE TABLE ingestion.raw_{{CONNECTOR_ID}}_2026_08
--     PARTITION OF ingestion.raw_{{CONNECTOR_ID}}
--     FOR VALUES FROM ('2026-08-01') TO ('2026-09-01');
