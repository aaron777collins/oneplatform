{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "jaeger", "name": "Jaeger", "version": "1.0.0" }
  ],
  "annotations": {
    "list": []
  },
  "description": "Data Ingestion Service: active sync count, success/failure rate, connector health, and rows-ingested trend derived from Jaeger span data.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["oneplatform"],
      "targetBlank": false,
      "title": "Platform Overview",
      "tooltip": "",
      "type": "link",
      "url": "/d/op-platform-overview"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "Sync Status",
      "type": "row"
    },
    {
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "description": "Traces from ingestion-service that are still in-flight (have a start time but no end time within the selected window). Each trace corresponds to one sync job being processed by the ingestion worker.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 201,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Active Syncs (in-flight traces)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "jaeger" },
          "queryType": "search",
          "service": "ingestion-service",
          "operation": "sync.run",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "description": "Ingestion-service spans that completed without an error tag. A healthy connector produces one span per sync job with status=ok. This count is a proxy for successful syncs in the selected window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 202,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Successful Syncs",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "jaeger" },
          "queryType": "search",
          "service": "ingestion-service",
          "operation": "sync.run",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "description": "Ingestion-service spans tagged with error=true. Each error span maps to one failed sync job. Consecutive failures from the same connector indicate a broken data source or credential issue — check the full trace for the root cause.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 203,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Failed Syncs",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "jaeger" },
          "queryType": "search",
          "service": "ingestion-service",
          "operation": "sync.run",
          "tags": "error=true",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "description": "Rows written during the selected time window, derived from the rows_ingested span tag set by the ingestion service on each sync.run span. If this value is zero but syncs are running, traces may be missing the rows_ingested tag — check the ingestion service OTEL instrumentation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 204,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Rows Ingested (span tag sum)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "jaeger" },
          "queryType": "search",
          "service": "ingestion-service",
          "tags": "rows_ingested",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 205,
      "title": "Sync Trends",
      "type": "row"
    },
    {
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "description": "Sync success and failure counts over time from ingestion-service trace data. A sustained divergence where failures > successes indicates a systemic connector problem requiring investigation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "syncs / bucket",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failures" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Successes" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 206,
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "title": "Sync Success vs. Failure Rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "jaeger" },
          "queryType": "search",
          "service": "ingestion-service",
          "operation": "sync.run",
          "refId": "A",
          "legendFormat": "Successes"
        },
        {
          "datasource": { "type": "jaeger", "uid": "jaeger" },
          "queryType": "search",
          "service": "ingestion-service",
          "operation": "sync.run",
          "tags": "error=true",
          "refId": "B",
          "legendFormat": "Failures"
        }
      ]
    },
    {
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "description": "Sync job duration over time from ingestion-service span data. Duration spikes without a corresponding error indicate large data volumes from the source — consider increasing OP_INGESTION_BATCH_SIZE or adding more ingestion worker replicas.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "duration (ms)",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "points",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 4,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "always",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30000 },
              { "color": "red", "value": 120000 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 207,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "title": "Sync Duration (sampled spans)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "jaeger" },
          "queryType": "search",
          "service": "ingestion-service",
          "operation": "sync.run",
          "refId": "A",
          "legendFormat": "sync.run duration"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 208,
      "title": "Connector Health",
      "type": "row"
    },
    {
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "description": "Recent traces from the ingestion service, ordered by start time. Each row is one trace — click the trace ID to open the full span tree in the Jaeger UI. Use the connector.id tag filter to scope to a specific connector.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "left",
            "displayMode": "auto",
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "id": 209,
      "options": {
        "footer": { "enablePagination": true, "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Start Time" }]
      },
      "title": "Recent Ingestion Traces",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "jaeger" },
          "queryType": "search",
          "service": "ingestion-service",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["oneplatform", "ingestion"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "OnePlatform — Data Ingestion",
  "uid": "op-ingestion",
  "version": 1
}
