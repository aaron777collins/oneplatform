# Plain HTTP mode — for local development behind another proxy (ngrok, etc.).
# WARNING: never use in production.

{
	admin off
	log {
		output stdout
		format json
	}
}

:80 {
	header {
		X-Content-Type-Options     "nosniff"
		X-Frame-Options            "DENY"
		Referrer-Policy            "strict-origin-when-cross-origin"
		Permissions-Policy         "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy    "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
		-Server
	}

	# Health/readiness probes — forwarded to the gateway service so that
	# external load balancers and orchestrators can probe Caddy directly.
	handle /healthz {
		reverse_proxy gateway-service:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP         {remote_host}
			# Preserve the original Host so upstream CORS same-origin detection works.
			# Without this Caddy rewrites Host to the upstream address (gateway-service:3000)
			# and the middleware can never match it against the browser's Origin header.
			header_up Host              {hostport}
		}
	}

	handle /readyz {
		reverse_proxy gateway-service:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP         {remote_host}
			header_up Host              {hostport}
		}
	}

	handle /api/* {
		reverse_proxy gateway-service:3000 {
			header_up X-Forwarded-Proto  {scheme}
			header_up X-Real-IP          {remote_host}
			header_up X-Forwarded-Host   {http.request.header.Host}
			header_up Host               {http.request.header.Host}
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:80 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP         {remote_host}
			header_up Host              {hostport}
		}
	}
}
