user default off nopass ~* &* -@all
user op_admin on >CHANGE_ME_redis_admin ~* &* +@all
user op_auth on >CHANGE_ME_auth ~auth:* ~revocation:* ~reset:* &auth:* &revocation:* +@read +@write +@string +@hash +@set +@sortedset +@pubsub +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_pipeline on >CHANGE_ME_pipeline ~queue:pipeline:* ~queue:execution:* &ontology:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_logging on >CHANGE_ME_logging ~log:* ~audit:* &logs:* &audit:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_gateway on >CHANGE_ME_gateway ~ratelimit:* ~gateway:* ~webhook:* &events:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_ingestion on >CHANGE_ME_ingestion ~queue:ingestion:* ~ingestion:sync:* &ontology:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_ontology on >CHANGE_ME_ontology ~ontology:* &ontology:* +@read +@write +@string +@hash +@set +@sortedset +@pubsub +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_app on >CHANGE_ME_app ~guest-session:* &events:* +@read +@write +@string +@hash +@pubsub +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_plugin on >CHANGE_ME_plugin ~plugin:* &events:* +@read +@write +@string +@hash +@set +@pubsub +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
