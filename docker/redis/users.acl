user default off nopass ~* &* -@all
user op_admin on >CHANGE_ME_redis_admin ~* &* +@all
user op_auth on >CHANGE_ME_auth ~auth:* ~revocation:* ~reset:* ~bull:auth* &auth:* &revocation:* &events:* &bull:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +@scripting +@connection +@transaction +info +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_pipeline on >CHANGE_ME_pipeline ~queue:pipeline:* ~queue:execution:* ~bull:queue.pipeline.run* ~bull:queue.execution* ~revocation:* &ontology:* &bull:* &events:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +@scripting +@connection +@transaction +info +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_logging on >CHANGE_ME_logging ~log:* ~audit:* ~bull:audit* ~bull:log* ~revocation:* &logs:* &audit:* &bull:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +@scripting +@connection +@transaction +info +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_gateway on >CHANGE_ME_gateway ~ratelimit:* ~gateway:* ~webhook:* ~metering:* ~revocation:* &events:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +@scripting +@connection +@transaction +info +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_ingestion on >CHANGE_ME_ingestion ~ingestion:sync:* ~ingestion:cdc:* ~ingestion:stream:* ~bull:ingestion.sync* ~bull:ingestion.batch* ~bull:ingestion.file-parse* ~bull:ingestion.reconcile* ~bull:ontology.map* ~revocation:* &ingestion:* &ontology:* &bull:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +@scripting +@connection +@transaction +info +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_ontology on >CHANGE_ME_ontology ~ontology:* ~bull:ontology.map* ~revocation:* &ontology:* &bull:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +@scripting +@connection +@transaction +info +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_app on >CHANGE_ME_app ~guest-session:* ~rate:guest-session:* ~app:* ~bff:* ~bull:queue.app.retention* ~revocation:* &events:* &app:* &bull:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +@scripting +@connection +@transaction +info +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_plugin on >CHANGE_ME_plugin ~plugin:* ~bull:plugin* ~revocation:* &events:* &bull:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +@scripting +@connection +@transaction +info +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
user op_execution on >CHANGE_ME_execution ~execution:* ~revocation:* &execution:* +@read +@write +@string +@hash +@set +@sortedset +@list +@pubsub +@scripting +@connection +@transaction +info +expire +del +exists +ttl +pttl -select -flushdb -flushall -keys -debug
