# docker/Dockerfile.frontend
#
# Multi-stage build for the OnePlatform React SPA.
#
# Stage 1 (builder): installs deps and runs Vite build.
# Stage 2 (runner):  nginx:alpine serving the built SPA with the nginx.conf
#                    from the frontend package. The gateway upstream hostname
#                    is substituted at container start via envsubst so a single
#                    image works in any environment (dev, staging, prod).

ARG NODE_VERSION=22

# ─── Stage 1: Build the React SPA ────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /build

# Copy workspace manifests first for Docker layer caching.
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY .npmrc ./

# Copy all workspace package.json files.
COPY packages/frontend/package.json    ./packages/frontend/package.json
COPY packages/core/package.json        ./packages/core/package.json
COPY packages/sdk/package.json         ./packages/sdk/package.json
COPY packages/app-sdk/package.json     ./packages/app-sdk/package.json
COPY packages/plugin-sdk/package.json  ./packages/plugin-sdk/package.json
COPY packages/cli/package.json         ./packages/cli/package.json
COPY services/gateway/package.json     ./services/gateway/package.json
COPY services/auth/package.json        ./services/auth/package.json
COPY services/ingestion/package.json   ./services/ingestion/package.json
COPY services/ontology/package.json    ./services/ontology/package.json
COPY services/pipeline/package.json    ./services/pipeline/package.json
COPY services/execution/package.json   ./services/execution/package.json
COPY services/app/package.json         ./services/app/package.json
COPY services/logging/package.json     ./services/logging/package.json
COPY services/plugin/package.json      ./services/plugin/package.json

RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm --filter @oneplatform/frontend build

# ─── Stage 2: nginx runtime ──────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Install gettext for envsubst (Alpine nginx image does not include it).
RUN apk add --no-cache gettext

# Copy the built SPA assets from the builder stage.
COPY --from=builder /build/packages/frontend/dist /usr/share/nginx/html

# Copy the nginx config as a template. envsubst will substitute
# $NGINX_GATEWAY_URL before nginx starts (default: http://gateway-service:3000).
COPY --from=builder /build/packages/frontend/nginx.conf /etc/nginx/nginx.conf.template

# The startup script substitutes the gateway URL and launches nginx.
COPY docker/nginx-frontend-start.sh /usr/local/bin/nginx-frontend-start.sh
RUN chmod +x /usr/local/bin/nginx-frontend-start.sh

EXPOSE 80

CMD ["/usr/local/bin/nginx-frontend-start.sh"]
