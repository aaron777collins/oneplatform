# .env.example
#
# Copy to .env and fill in values before running docker compose:
#   cp .env.example .env
#
# IMPORTANT: Most secrets (OP_MASTER_KEY, OP_JWT_SECRET, OP_CURSOR_SECRET, all
# per-service DB/Redis passwords, and Ed25519 key pairs) are generated
# automatically by the op-init container on first start. You do NOT need to set
# those here unless you are rotating keys and need to inject pre-existing values.
#
# All variables have a working default for local development with docker-compose.
# In production, override OP_MINIO_PASSWORD (and other secrets) with strong values.
#
# Ref spec Appendix A "Environment Variables (Key)".

# ─── Infrastructure Passwords ─────────────────────────────────────────────────
# REQUIRED to be changed in production. Generate with: openssl rand -hex 32
# The value below is the development default and is rejected by docker-compose.prod.yml.
#
# NOTE: Per-service role passwords (auth_service_role, gateway_service_role, etc.)
# are generated by op-init and applied automatically by set-passwords.sh.
# You do NOT need to set them here.
POSTGRES_PASSWORD=dev_postgres_superuser

# REDIS_ADMIN_PASSWORD is used by the docker-compose healthcheck to ping Redis
# as op_admin. This must match the password op-init writes to
# /data/init/redis_password_admin.txt.
# In development this is handled automatically; in production override here only
# if you need to inject a pre-rotated credential.
# REDIS_ADMIN_PASSWORD is read at runtime from /data/init/redis_password_admin.txt
# by the redis healthcheck wrapper — leave blank unless overriding.

# PgBouncer admin credentials — generated by op-init, no action needed.

# ─── MinIO ────────────────────────────────────────────────────────────────────
# Ref spec Appendix A: OP_MINIO_USER, OP_MINIO_PASSWORD
# OP_MINIO_USER is the MinIO root user (console login). Default is fine for dev.
OP_MINIO_USER=minioadmin
# For production, generate with: openssl rand -hex 32
# The default below works out-of-the-box for local development.
# In production docker-compose.prod.yml rejects this value.
OP_MINIO_PASSWORD=oneplatform_minio_dev_2024

# ─── Required Service Connection URLs ─────────────────────────────────────────
# OP_DATABASE_URL and OP_REDIS_URL are REQUIRED by the Zod config schema.
# Every service crashes on startup without them.
#
# In docker-compose these are injected per-service using per-role credentials
# (e.g. postgres://auth_service_role:<password>@pgbouncer:5433/oneplatform_auth).
# The values below are correct for the docker-compose network when using PgBouncer.
#
# For local development OUTSIDE docker-compose (e.g. pnpm dev), set these to
# point at your local Postgres and Redis instances:
OP_DATABASE_URL=postgres://op_admin:dev_postgres_superuser@localhost:5432/oneplatform
OP_REDIS_URL=redis://localhost:6379

# ─── Auth Secrets (generated by op-init — read from volume at runtime) ────────
# Services read OP_JWT_SECRET, OP_MASTER_KEY, OP_CURSOR_SECRET from the
# init-data volume at /data/init/{jwt.secret,master.key,cursor.secret}.
# The docker-compose.yml injects these into each container's environment by
# reading the generated files.
#
# For local development OUTSIDE docker-compose, set these manually:
# OP_MASTER_KEY=<run: openssl rand -base64 32>
# OP_JWT_SECRET=<run: openssl rand -hex 32>
# OP_CURSOR_SECRET=<run: openssl rand -hex 32>
#
# For docker-compose: these are injected automatically — do NOT set here.

# ─── Bootstrap Token (generated by op-init — single use) ─────────────────────
# OP_BOOTSTRAP_TOKEN is written to /data/init/bootstrap.token by op-init.
# The Auth Service reads it at startup and erases the file after first use.
# For local development OUTSIDE docker-compose:
# OP_BOOTSTRAP_TOKEN=<run: openssl rand -hex 32>
#
# For docker-compose: injected automatically — do NOT set here.

# ─── TLS / Caddy ─────────────────────────────────────────────────────────────
# TLS termination mode for the Caddy reverse proxy.
#   internal — Caddy generates a self-signed cert via its internal CA (default for dev).
#   auto     — Let's Encrypt via HTTP-01 ACME. Requires OP_DOMAIN and OP_TLS_EMAIL.
#   off      — Plain HTTP only. For local dev behind another proxy (e.g. ngrok).
OP_TLS_MODE=internal

# Public domain name. Required when OP_TLS_MODE=auto.
# OP_DOMAIN=platform.example.com

# Let's Encrypt account email. Required when OP_TLS_MODE=auto.
# OP_TLS_EMAIL=admin@example.com

# ─── Platform Identity ────────────────────────────────────────────────────────
# Base URL used in redirect URIs, email links, and OAuth callbacks.
# Must be set in production. Include protocol, no trailing slash.
# Dev (OP_TLS_MODE=internal): https://localhost
# Prod (OP_TLS_MODE=auto):    https://platform.example.com
OP_BASE_URL=https://localhost

# Comma-separated list of allowed CORS origins.
# In production: must be set explicitly. Wildcard * is rejected in production.
# Ref spec §6 "CORS Policy".
OP_ALLOWED_ORIGINS=https://localhost,http://localhost:5173

# Optional: enables subdomain app routing (e.g., myapp.apps.example.com).
# Ref spec §9 "OAuth Client Lifecycle".
# OP_WILDCARD_DOMAIN=apps.example.com

# ─── Gateway ──────────────────────────────────────────────────────────────────
# Required for multi-replica Gateway deployments to correctly calculate the
# per-replica rate limit share. Ref spec §6 "Rate Limiting".
# OP_GATEWAY_REPLICAS=1

# Global rate limit in requests per minute (platform-wide).
# Ref spec §6 "Rate Limiting" — default 10000.
OP_GLOBAL_RATE_LIMIT=10000

# ─── Execution / Sandbox ──────────────────────────────────────────────────────
# Pre-warmed Docker sandbox container pool size.
# Ref spec §7.6 "Execution Service" — default 5.
OP_SANDBOX_POOL_SIZE=5

# Default connector timeout in seconds.
# Ref spec §7.6 "Execution Service" — default 300.
OP_CONNECTOR_TIMEOUT_SECONDS=300

# ─── Ingestion ────────────────────────────────────────────────────────────────
# Records per ingestion batch (default 1000, max 10000).
OP_INGESTION_BATCH_SIZE=1000

# Concurrency for large syncs (>1M records).
OP_LARGE_SYNC_CONCURRENCY=3

# ─── Ontology ────────────────────────────────────────────────────────────────
# Maximum schema migration duration in seconds (default 3600 = 1 hour).
OP_MIGRATION_TIMEOUT=3600

# Fallback poll interval for ontology cache refresh in seconds (default 15).
# The primary mechanism is Redis pub/sub; this is the safety net.
# Ref spec §5 "Ontology cache".
OP_ONTOLOGY_POLL_INTERVAL=15

# ─── Auth / Email ─────────────────────────────────────────────────────────────
# Whether to require email verification before allowing full access.
# First admin (bootstrap) is always auto-verified regardless of this setting.
# Ref spec §4 "Email Verification".
OP_REQUIRE_EMAIL_VERIFICATION=false

# SMTP configuration for sending verification and password reset emails.
# If not set, Auth Service operates in link-copy mode (displays the link).
# Ref spec §7.2 "Auth Service" — link-copy mode when SMTP unconfigured (ADR-36).
# OP_SMTP_HOST=smtp.example.com
# OP_SMTP_PORT=587
# OP_SMTP_USER=noreply@example.com
# OP_SMTP_PASS=CHANGE_ME_smtp
# OP_SMTP_FROM=OnePlatform <noreply@example.com>
# OP_SMTP_SECURE=true

# ─── Object Storage ───────────────────────────────────────────────────────────
# By default, MinIO is used. Set OP_S3_ENDPOINT to switch to AWS S3 or
# Cloudflare R2 with no code changes. Ref spec §3 "MinIO: Buckets and IAM".
# OP_S3_ENDPOINT=https://s3.amazonaws.com
# OP_S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# OP_S3_SECRET_KEY=CHANGE_ME_s3_secret
# OP_S3_REGION=us-east-1

# ─── Webhooks ─────────────────────────────────────────────────────────────────
# Allow HTTP (non-HTTPS) webhook URLs. DEV ONLY. Never set true in production.
# Ref spec §11 "Outbound Webhooks" — HTTPS required in production.
OP_WEBHOOK_ALLOW_HTTP=false

# ─── Observability ────────────────────────────────────────────────────────────
# OTLP endpoint for distributed tracing. All services emit W3C Trace Context
# spans to this endpoint. In docker-compose, Jaeger's all-in-one image handles
# the OTLP/HTTP endpoint and trace UI. In production, point at an OTEL Collector
# that fans out to your backend (Jaeger, Tempo, Datadog, etc.).
# Jaeger UI: http://localhost:16686 (127.0.0.1 only, never exposed publicly).
# Ref G-025 "OTEL Observability".
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ─── Secrets generated by op-init (READ-ONLY — do not set unless overriding) ──
# These are generated by op-init and written to /data/init/ on first start.
# Services read them from the mounted volume. You should NOT set these here
# unless you are rotating keys and need to inject pre-existing values.
# Ref spec §2 "Startup Sequence" step 1 and §4 "First-Run Bootstrap".
# OP_MASTER_KEY=<generated by op-init — see /data/init/master.key>
# OP_JWT_SECRET=<generated by op-init — see /data/init/jwt.secret>
# OP_CURSOR_SECRET=<generated by op-init — see /data/init/cursor.secret>
# OP_BOOTSTRAP_TOKEN=<generated by op-init — see /data/init/bootstrap.token>
