        "description": "Returns paginated execution history for the authenticated tenant. Supports filtering by status and type. Requires execution:read scope.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "filter[status][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "error",
                "timeout",
                "killed"
              ]
            }
          },
          {
            "name": "filter[type][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "code",
                "connector-run",
                "app-build",
                "expression",
                "plugin-drain"
              ]
            }
          }
        ]
      }
    },
